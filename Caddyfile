{$FOGPILOT_DOMAIN:localhost} {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /healthz {
        reverse_proxy backend:8000
    }
    handle /metrics {
        reverse_proxy backend:8000
    }
    handle /ws {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:80
    }
}
